# Copy this file to .env for local development. Never commit the real .env.

# Get a key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# FREE_CHATS=5
# GUIDES_ALWAYS_ON=1

# Optional: local port (Cloud Run sets this itself)
# PORT=8080

# Optional WhatsApp link shown on the site (https://wa.me/91XXXXXXXXXX)
WHATSAPP_URL=

# Your real website address, used in the sitemap and page links (optional)
PUBLIC_URL=
