# Kundli Kaka settings. Leave a value empty if you do not use that feature.

# AI (replies, reports, Krishna)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Login and wallet (Firebase)
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Call Krishna: set to on to switch the live voice call on
GEMINI_VOICE=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Keep the bill predictable in a crowd (optional): calls at the same moment, and free first-minute calls handed out per day
MAX_CONCURRENT_CALLS=20
FREE_CALLS_PER_DAY=300

# Prices in whole rupees (optional)
PRICE_CALL_RUPEES=10
PRICE_MILAN_RUPEES=169

# Site
PUBLIC_URL=https://kundlikaka.in
WHATSAPP_URL=
GA_ID=
GUIDES_ALWAYS_ON=
PORT=3000
